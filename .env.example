# =====================================================================
# 智能旅游规划 Agent 环境变量示例
# 复制本文件为 .env 后按需填写：cp .env.example .env
# 除特别标注外，留空的 Key 会触发对应能力的自动降级，不会导致启动失败。
# =====================================================================

# ===== 应用 =====
# 运行环境：dev（彩色日志）/ prod（JSON 日志）/ test
APP_ENV=dev
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 是否强制输出 JSON 结构化日志（留空时 prod 自动开启）
LOG_JSON=
# 监听地址与端口（容器内使用 0.0.0.0）
HOST=127.0.0.1
PORT=8000

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek，也可换通义/智谱） =====
# DeepSeek：https://platform.deepseek.com/  注册即送额度
# 通义千问：https://dashscope.console.aliyun.com/apiKey  兼容模式 base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM：https://open.bigmodel.cn/usercenter/apikeys  base_url=https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# 单次 LLM 请求超时（秒）：行程草稿等长文本生成实测 9-24s，须给足余量；
# 与下方 EXTERNAL_TIMEOUT（外部工具接口短超时）是两套独立值，切勿混用
LLM_TIMEOUT=120

# ===== 通用网页搜索 =====
# 降级链顺序，用逗号分隔；任一 Provider 无 Key 或失败自动切下一个
SEARCH_PROVIDER_CHAIN=tavily,bocha,duckduckgo
# Tavily：https://tavily.com  专为 LLM 设计，免费额度约 1000 次/月
TAVILY_API_KEY=
# 博查 Bocha（国内）：https://open.bochaai.com  需注册申请
BOCHA_API_KEY=
# DuckDuckGo 免 Key 兜底，无需填写任何变量

# ===== 地图 / POI / 路径 =====
# 默认仅高德：本部署环境无法访问 OSM 公共端点（Nominatim/Overpass/OSRM）。
# 网络可达 OpenStreetMap 的环境可改为 amap,osm 恢复免 Key 兜底（公交路径仅高德支持）。
MAPS_PROVIDER_CHAIN=amap
# 高德开放平台：https://lbs.amap.com  个人开发者 Web 服务约 5000 次/日（默认链下为必需能力）
AMAP_API_KEY=
# Google Maps（海外目的地，预留，后续阶段接入）：https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# ===== 外部 HTTP 统一参数 =====
# 单次请求超时（秒）；失败按指数退避重试，仍失败则自动切降级链下一个 Provider
EXTERNAL_TIMEOUT=10
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_DELAY=0.5

# ===== 天气 =====
# 降级链：和风天气优先，Open-Meteo 免 Key 兜底
WEATHER_PROVIDER_CHAIN=qweather,openmeteo
# 和风天气：https://dev.qweather.com  免费订阅约 1000 次/日
QWEATHER_API_KEY=
# 免费订阅默认 devapi 域名；若控制台给出专属 API Host 请在此覆盖
QWEATHER_API_HOST=https://devapi.qweather.com
# Open-Meteo：https://open-meteo.com  完全免费、无需 Key

# ===== 数据库（MySQL；本地 127.0.0.1:3306 root/1234） =====
# 部署前先建库：CREATE DATABASE travel_agent CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:1234@127.0.0.1:3306/travel_agent?charset=utf8mb4
# LangGraph Checkpointer 独立 SQLite 文件（仅 CLI 离线会话记忆用，与业务库 MySQL 分离）
CHECKPOINT_DB=./data/checkpoints.db

# ===== 缓存（diskcache 本地 TTL 缓存，单位：秒） =====
CACHE_DIR=./data/cache
CACHE_TTL_SEARCH=21600
CACHE_TTL_POI=86400
CACHE_TTL_WEATHER=3600
CACHE_TTL_ROUTE=604800

# ===== Agent 编排（阶段三） =====
# 检索扇出并发上限（POI/酒店/贴士/攻略同时打出去的最大并发，1-16）
FANOUT_CONCURRENCY=4
# 高德 POI 两次请求最小间隔秒数（个人开发者 QPS 限制，0-10，0 表示不限流）
POI_MIN_INTERVAL_S=1.0
# 每日游玩时长上限（小时）
MAX_DAILY_HOURS=8
# 行程校验-修订循环最大次数，超出强制跳出并提示用户
MAX_REVISE_LOOPS=3
# 默认币种
DEFAULT_CURRENCY=CNY

# ===== 可观测性（可选） =====
# Langfuse 自托管或云版：https://cloud.langfuse.com  免费额度可看逐步骤 trace 与 token 成本
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
